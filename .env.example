# BreastCare AI — Environment Variables
# Copy this file to .env and fill in your key.

# Required for the AI explanation panel (Layers 4+5 of the pipeline).
# WITHOUT this key: ML prediction + SHAP explainability still work fully.
# WITH this key: the Gemini AI explanation and Q&A panel activate.
#
# HOW TO GET A FREE KEY (no credit card required):
#   1. Go to https://aistudio.google.com
#   2. Sign in with your Google account
#   3. Click "Get API key" → "Create API key"
#   4. Copy the key and paste it below
#
GEMINI_API_KEY=your-gemini-key-here

# ── Optional: independent judges for the evaluations only (src/evals/common.py) ──
# The app never uses these. They let models from other families grade the assistant's
# answers and red-team replies, alongside the Gemini judge. Each judge takes part only
# when its key is set. All three have free tiers (limits checked 2026-10-13).
#
# Recommended: Cerebras, gpt-oss-120b (1M tokens/day free).
#   1. Go to https://cloud.cerebras.ai and sign up (free)
#   2. Open "API Keys" and create a key
#   3. Paste it below and remove the leading "#"
# CEREBRAS_API_KEY=your-cerebras-key-here
#
# Optional second judge: Groq, qwen3.8-27b and gpt-oss-120b (about 1,000 requests/day free).
#   https://console.groq.com → API Keys → Create API Key
# GROQ_API_KEY=your-groq-key-here
#
# Optional: OpenRouter (free models allow only about 50 requests/day without credits).
#   https://openrouter.ai/keys ; also name a free model, e.g. one ending in ":free"
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_JUDGE_MODEL=provider/model:free

# ── Optional: more language models for /api/chat (server.py, API 2.4.0) ──
# One OpenAI-compatible provider (Groq, OpenRouter, a local Ollama). Its models are listed in
# /health (llm.models) and a chat request may name one; Gemini stays the default.
# Only the default Gemini model was evaluated by the held-out safety run; other models are not evaluated.
# Remove the leading "#" from one block. The key is optional (Ollama needs none).
#
# Groq: https://console.groq.com → API Keys
# EXTRA_LLM_PROVIDER=groq
# EXTRA_LLM_BASE_URL=https://api.groq.com/openai/v1
# EXTRA_LLM_MODELS=openai/gpt-oss-120b
# EXTRA_LLM_API_KEY=your-groq-key-here
#
# OpenRouter: https://openrouter.ai/keys (free models end in ":free")
# EXTRA_LLM_PROVIDER=openrouter
# EXTRA_LLM_BASE_URL=https://openrouter.ai/api/v1
# EXTRA_LLM_MODELS=provider/model:free
# EXTRA_LLM_API_KEY=your-openrouter-key-here
#
# Local Ollama (no key; run `ollama pull llama3.2` first)
# EXTRA_LLM_PROVIDER=ollama
# EXTRA_LLM_BASE_URL=http://localhost:11434/v1
# EXTRA_LLM_MODELS=llama3.2

# ── Deployment limits (server.py) ──
# Audit endpoints (/api/audit/*) expose logged assessments and chat questions. They stay disabled
# unless a long random token is set here; clients then send "Authorization: Bearer <token>".
# AUDIT_API_TOKEN=
# Origins allowed to call the API from a browser (comma-separated). Default: local dev servers.
# ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
# Chat limits per server process (each instance counts separately on a multi-instance host).
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_DAILY_LIMIT=300
# Upload limits
# MAX_IMAGE_BYTES=10485760
# MAX_CSV_BYTES=2097152
# MAX_BATCH_ROWS=5000
