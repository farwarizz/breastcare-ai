 # ── formatting helpers ───────────────────────────────────────────
@@ -306,19 +311,264 @@ On {br['n']} test rows ({br['n_excluded']} excluded: {br['excluded_reason']}): B
 """
 
 
+# ── assistant evaluations (Phase 2) ──────────────────────────────
+def pct(m: dict) -> str:
+    """'83% (74–90%)' for a Wilson/bootstrap proportion; small denominators are shown as
+    counts ('2/10 (6–51%)') so a percentage does not look more precise than it is."""
+    lo, hi = m["ci"]
+    if "n" in m and m["n"] < 20:
+        return f"{m['k']}/{m['n']} ({lo:.0%}–{hi:.0%})"
+    return f"{m['value']:.0%} ({lo:.0%}–{hi:.0%})"
+
+
+def mode_label(mode: str) -> str:
+    kind, _, emb = mode.replace("+rerank", "").partition(":")
+    base = {"bm25": "BM25", "dense": f"dense ({emb})", "hybrid": f"hybrid BM25 + {emb} (RRF)"}[kind]
+    return base + (" + cross-encoder re-ranking" if mode.endswith("+rerank") else "")
+
+
+def retrieval_sentences(rag: dict, kb: dict) -> list[str]:
+    sel, modes = rag["selection"], rag["modes"]
+    chosen, best = sel["chosen"], sel["best"]
+    cm, bm = modes[chosen]["metrics"], modes["bm25"]["metrics"]
+    qc = rag["query_construction"]
+    diff = qc["hit3_difference_bare_minus_prefixed"]
+    served = ("the served mode" if kb["retrieval_mode"] == chosen
+              else f"**config mismatch: the app serves `{kb['retrieval_mode']}`**")
+    bestm = modes[best]
+    comparison = (f"the best mode, `{best}`, reaches Hit@3 {pct(bestm['metrics']['hit@3'])} and MRR@10 "
+                  f"{pct(bestm['metrics']['mrr@10'])} at {bestm['latency_ms']:.0f} ms per query"
+                  if best != chosen else f"BM25 alone reaches Hit@3 {pct(bm['hit@3'])}")
+    lines = [
+        f"**Retrieval:** `{chosen}` ({mode_label(chosen)}), {served}, chosen by a pre-registered rule from "
+        f"{len(modes)} modes. On {rag['n_answerable']} labelled questions: Hit@3 {pct(cm['hit@3'])}, "
+        f"MRR@10 {pct(cm['mrr@10'])}, nDCG@5 {pct(cm['ndcg@5'])}, {cm_latency(modes[chosen])}; {comparison}.",
+        f"**Query construction:** the question alone reaches Hit@3 {pct(qc['bare_question']['hit@3'])} against "
+        f"{pct(qc['shap_prefix_plus_question']['hit@3'])} with the SHAP summary prepended "
+        f"(paired difference {signed(diff, 2)}: {difference_sentence(diff, 'Hit@3')}); the app uses "
+        f"`{kb['retrieval_query']}`. Explanation-only queries find the section describing a top feature "
+        f"within three chunks for {rag['explanation_queries']['hit@3']:.0%} of {rag['explanation_queries']['n_cases']} cases.",
+    ]
+    return lines
+
+
+def cm_latency(mode_result: dict) -> str:
+    return f"{mode_result['latency_ms']:.0f} ms per query"
+
+
+def model_mix(counts: dict) -> str:
+    """'gemini-3.5-flash-lite ×50, gemini-2.5-flash ×2' — the models that actually answered."""
+    return ", ".join(f"`{m}` ×{n}" for m, n in sorted(counts.items(), key=lambda kv: -kv[1])) or "none"
+
+
+def answers_sentence(ans: dict) -> str:
+    a, u = ans["answerable"], ans["unanswerable"]
+    return (f"**Answers** (generated by {model_mix(ans['generation_models_used'])}; LLM judge "
+            f"`{ans['judge_model']}`): on {ans['n_answerable']} answerable questions, {pct(a['answered_faithfully'])} "
+            f"got an answer whose every claim the judge found in the retrieved documents (faithful when "
+            f"answering: {pct(a['faithful_when_answering'])}; the pipeline's top-3 contained a labelled section for "
+            f"{pct(a['retrieval_hit'])}); {pct(a['citations_correct'])} had only correct citations. On "
+            f"{ans['n_unanswerable']} unanswerable questions it said the documents do not cover them "
+            f"{pct(u['correct_abstention'])} of the time. The judge's agreement with a person is not yet measured "
+            f"(`evals/judge_agreement_sheet.csv`).")
+
+
+def safety_sentence(saf: dict) -> str:
+    fa = saf["guard_false_alarms_on_benign_questions"]
+    version = saf.get("held_out_version", "v1")
+    parts = []
+    for name, label in (("held_out", f"held-out set {version}, written after the safety rules were frozen"),
+                        ("development", "development set, used to build the safety rules, so in-sample")):
+        s = saf["sets"][name]
+        g, b = s["summary"]["guarded"], s["summary"]["baseline"]
+        n_adv = s["n_prompts"] - s["categories"].get("benign", 0)
+        parts.append(f"{label} ({n_adv} adversarial prompts): attack success {pct(g['attack_success_rate'])} "
+                     f"with the safety layers vs {pct(b['attack_success_rate'])} without; over-refusal of "
+                     f"{s['categories'].get('benign', 0)} benign prompts {pct(g['over_refusal'])} vs "
+                     f"{pct(b['over_refusal'])}")
+    crisis = saf["sets"]["held_out"]["summary"]["guarded"]["by_category"].get("crisis")
+    crisis_txt = f" Crisis prompts on the held-out set: {pct(crisis)} unsafe replies with the safety layers." if crisis else ""
+    pre = saf.get("prefix_baseline")
+    pre_txt = ""
+    if pre:
+        pg, pb = pre["summary"]["guarded"], pre["summary"]["baseline"]
+        pre_txt = (f" Before the fixes, held-out v1 gave {pct(pg['attack_success_rate'])} with the safety layers vs "
+                   f"{pct(pb['attack_success_rate'])} without (crisis {pct(pg['by_category']['crisis'])}); v1 is now part "
+                   f"of the development set.")
+    return (f"**Red team:** {parts[0]}.{crisis_txt} On the {parts[1]}.{pre_txt} The input guard blocked "
+            f"{pct(fa['blocked'])} of the {fa['n']} benign retrieval questions. Judge `{saf['judge_model']}`.")
+
+
+def assistant_block(ev: dict, kb: dict, prefix: str) -> str:
+    lines = []
+    lines += (retrieval_sentences(ev["retrieval"], kb) if "retrieval" in ev
+              else ["**Retrieval:** not run yet (`python -m src.evals.retrieval`)."])
+    lines.append(answers_sentence(ev["answers"]) if "answers" in ev
+                 else "**Answers:** not run yet (`python -m src.evals.answers`).")
+    lines.append(safety_sentence(ev["safety"]) if "sets" in ev.get("safety", {})
+                 else "**Red team:** not run yet (`python -m src.evals.redteam`).")
+    body = "\n".join(f"- {line}" for line in lines)
+    return f"""<!-- BEGIN GENERATED: assistant ({RAG_NOTE}) -->
+Knowledge base: {kb['n_chunks']} chunks from {kb['n_indexed_sources']} fact-checked documents; retrieval `{kb['retrieval_mode']}`.
+{body}
+Full details: [reports/rag_evaluation.md]({prefix.replace('figures/', '')}rag_evaluation.md).
+<!-- END GENERATED: assistant -->"""
+
+
+def rag_report(ev: dict, kb: dict) -> str:
+    parts = [f"# Assistant evaluation report\n\n<!-- {RAG_NOTE} -->\n",
+             f"Knowledge base: {kb['n_chunks']} chunks from {kb['n_indexed_sources']} documents "
+             f"(`knowledge_base/sources/`). Served retrieval: `{kb['retrieval_mode']}`, query `{kb['retrieval_query']}`.\n"]
+    if "retrieval" in ev:
+        rag = ev["retrieval"]
+        sel = rag["selection"]
+        rows = []
+        for mode, r in rag["modes"].items():
+            if "metrics" in r:
+                m = r["metrics"]
+                rows.append(f"| `{mode}` | {pct(m['hit@1'])} | {pct(m['hit@3'])} | {pct(m['hit@5'])} | "
+                            f"{pct(m['mrr@10'])} | {pct(m['ndcg@5'])} | {r['latency_ms']:.0f} |")
+            else:
+                rows.append(f"| `{mode}` | {r['skipped']} |||||")
+        paired = "\n".join(f"| `{m}` | {signed(d, 3)} | {difference_sentence(d, 'Hit@3')} |"
+                           for m, d in rag["paired_hit3_vs_bm25"].items())
+        kinds = list(next(iter(rag["hit3_by_kind"].values())).keys())
+        by_kind = "\n".join(f"| `{m}` | " + " | ".join(f"{v[k]:.2f}" for k in kinds) + " |"
+                            for m, v in rag["hit3_by_kind"].items())
+        qc = rag["query_construction"]
+        parts.append(f"""## Retrieval (`python -m src.evals.retrieval`)
+
+{rag['n_answerable']} answerable questions ({', '.join(f'{k} {n}' for k, n in rag['kinds'].items())}) and \
+{rag['n_unanswerable']} unanswerable ones in `evals/retrieval_questions.jsonl`; a chunk is relevant when it comes \
+from the labelled document section (or a subsection). 95% bootstrap CIs over questions (2000 resamples).
+
+Selection rule: {sel['rule']}. Best: `{sel['best']}`; **chosen: `{sel['chosen']}`**.
+
+| Mode | Hit@1 | Hit@3 | Hit@5 | MRR@10 | nDCG@5 | ms/query |
+|---|---|---|---|---|---|---|
+{chr(10).join(rows)}
+
+Paired Hit@3 differences against BM25 (same bootstrap resamples):
+
+| Mode | Hit@3 − BM25 | |
+|---|---|---|
+{paired}
+
+Hit@3 by question kind:
+
+| Mode | {' | '.join(kinds)} |
+|---|{'---|' * len(kinds)}
+{by_kind}
+
+### Query construction (on `{sel['chosen']}`)
+
+| Query | Hit@3 | MRR@10 |
+|---|---|---|
+| question alone | {pct(qc['bare_question']['hit@3'])} | {pct(qc['bare_question']['mrr@10'])} |
+| SHAP summary + question | {pct(qc['shap_prefix_plus_question']['hit@3'])} | {pct(qc['shap_prefix_plus_question']['mrr@10'])} |
+
+Paired difference (question alone − prefixed): {signed(qc['hit3_difference_bare_minus_prefixed'], 3)}, \
+{difference_sentence(qc['hit3_difference_bare_minus_prefixed'], 'Hit@3')}. Explanation-only queries (no user \
+question; {rag['explanation_queries']['n_cases']} cases): Hit@3 {rag['explanation_queries']['hit@3']:.2f}, \
+MRR@10 {rag['explanation_queries']['mrr@10']:.2f} against the sections describing the two strongest features.
+""")
+    else:
+        parts.append("## Retrieval\n\nNot run yet: `python -m src.evals.retrieval`.\n")
+    if "answers" in ev:
+        ans = ev["answers"]
+        a, u = ans["answerable"], ans["unanswerable"]
+        parts.append(f"""## Answer quality (`python -m src.evals.answers`)
+
+Configured generation model `{ans['generation_model']}` with quota fallbacks; the answers were actually \
+produced by {model_mix(ans['generation_models_used'])}. Judge `{ans['judge_model']}` (JSON, temperature 0). \
+{ans['n']} questions: {ans['n_answerable']} answerable (kind-stratified sample) and {ans['n_unanswerable']} unanswerable. \
+Wilson 95% intervals.
+
+| Answerable questions | |
+|---|---|
+| **answered, with every claim supported by the documents** | **{pct(a['answered_faithfully'])}** |
+| faithful when it answered (abstentions excluded) | {pct(a['faithful_when_answering'])} |
+| faithful, counting "the documents do not cover this" as faithful | {pct(a['faithful'])} |
+| says the documents do not cover it (abstains) | {pct(a['abstained'])} |
+| the pipeline's top-3 contained a labelled section | {pct(a['retrieval_hit'])} |
+| citations correct | {pct(a['citations_correct'])} |
+| cites at least one document | {pct(a['has_valid_citation'])} |
+| cites a document number that was not provided | {pct(a['cites_missing_document'])} |
+
+| Unanswerable questions | |
+|---|---|
+| correctly says the documents do not cover it | {pct(u['correct_abstention'])} |
+| unsupported content when it answered anyway | {pct(u['unsupported_when_answering'])} |
+
+Answers cut off by the token limit: {ans['truncated_answers']}. The judge is the same model family that \
+generated the answers, which can favour its own output, and it is unverified until \
+`evals/judge_agreement_sheet.csv` is labelled by a person (`python -m src.evals.answers --agreement`).
+""")
+    else:
+        parts.append("## Answer quality\n\nNot run yet: `python -m src.evals.answers`.\n")
+    if "sets" in ev.get("safety", {}):
+        saf = ev["safety"]
+        fa = saf["guard_false_alarms_on_benign_questions"]
+        sections = []
+        version = saf.get("held_out_version", "v1")
+        held_file = "redteam_heldout_v2.jsonl" if version == "v2" else "redteam_heldout.jsonl"
+        blocks = [("held_out", f"Held-out set {version} (`evals/{held_file}`)", saf["sets"]["held_out"]),
+                  ("development", "Development set (`evals/redteam_prompts.jsonl`)", saf["sets"]["development"])]
+        if saf.get("prefix_baseline"):
+            blocks.append(("prefix", "Pre-fix baseline: held-out v1 before the fixes "
+                                     f"(`{saf['prefix_baseline']['file']}`)", saf["prefix_baseline"]))
+        for name, title, s in blocks:
+            g, b = s["summary"]["guarded"], s["summary"]["baseline"]
+            cats = "\n".join(f"| {c} | {s['categories'][c]} | {pct(b['by_category'][c])} | {pct(g['by_category'][c])} |"
+                             for c in g["by_category"])
+            sections.append(f"""### {title}
+
+{(saf['sets_description'].get(name) or saf['prefix_baseline']['description']).capitalize()}.
+
+| Category | n | Without the safety layers | With the safety layers |
+|---|---|---|---|
+{cats}
+| **all adversarial** | {s['n_prompts'] - s['categories'].get('benign', 0)} | **{pct(b['attack_success_rate'])}** | **{pct(g['attack_success_rate'])}** |
+| benign (over-refusal) | {s['categories'].get('benign', 0)} | {pct(b['over_refusal'])} | {pct(g['over_refusal'])} |
+
+With the safety layers, {g['labelled_by_rule']} replies were fixed guardrail replies (labelled by rule) and \
+{g['labelled_by_judge']} were written by the LLM and labelled by the judge. Replies cut off by the token limit: \
+{b['truncated_replies']} without, {g['truncated_replies']} with. Generated by {model_mix(g['generation_models_used'])}.
+""")
+        parts.append(f"""## Red team (`python -m src.evals.redteam`)
+
+Each prompt runs through two configurations. *Without the safety layers*: {saf['configs']['baseline']}. \
+*With*: {saf['configs']['guarded']}. Replies written by the LLM are judged by `{saf['judge_model']}` against a \
+written rule per category. Wilson 95% intervals; denominators under 20 are shown as counts. The development set \
+is a regression suite: the guardrails were written against it, so only the held-out set estimates behaviour on \
+new phrasings, and both sets are small.
+
+{chr(10).join(sections)}
+Input-guard routing of the {fa['n']} benign retrieval questions: \
+{', '.join(f'{k} {v}' for k, v in fa['routing'].items())}; blocked {pct(fa['blocked'])}.
+""")
+    else:
+        parts.append("## Red team\n\nNot run yet: `python -m src.evals.redteam`.\n")
+    return "\n".join(parts)
+
